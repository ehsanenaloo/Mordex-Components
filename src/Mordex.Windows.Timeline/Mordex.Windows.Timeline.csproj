<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Mordex.Windows.Timeline</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Mordex.Windows.Scheduler\Mordex\Windows\Scheduler\Recurrence\RecurrenceRules.cs" Link="Mordex\Windows\Recurrence\RecurrenceRules.cs" />
    <Compile Include="..\Mordex.Windows.Scheduler\Mordex\Windows\Scheduler\Layout\LayoutTypeResolver.cs" Link="Mordex\Windows\Layouts\LayoutTypeResolver.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Mordex.Windows.Common/Mordex.Windows.Common.csproj" />
    <ProjectReference Include="../Mordex.Data/Mordex.Data.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources/*" Exclude="Resources/*.resx" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="Resources/*.resx" LogicalName="%(Filename).resources" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Mordex.Windows.Timeline.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
