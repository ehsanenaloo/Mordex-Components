    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ehsanenaloo/Mordex-Components</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ehsanenaloo/Mordex-Components</RepositoryUrl>
